VITE_API_URL=http://localhost:5000/api
# VITE_RAZORPAY_KEY_ID is no longer needed — the frontend fetches the key
# from GET /api/payment-config at runtime. Only set RAZORPAY_KEY_ID on the server.
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# AR "View on your wall" catalog (model-viewer models hosted on Vercel).
# Production/Preview builds read this from the Vercel dashboard env vars,
# NOT from this file — Vite bakes VITE_* values at build time.
VITE_AR_CATALOG_URL=https://ar-sage-eight.vercel.app/models/catalog.json

# Firebase Web SDK — get from Firebase Console → Project Settings → Your apps
# These are public identifiers, but committing them gets flagged by GitHub
# secret scanning and prevents rotation without a code change.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
