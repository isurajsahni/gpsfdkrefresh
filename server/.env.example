PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://your_user:your_strong_password@cluster.mongodb.net/gpsfdk?retryWrites=true&w=majority
JWT_SECRET=generate_with_node_e_require_crypto_randomBytes_64_toString_hex

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Resend)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=your_verified_sender@domain.com
# Legacy fallback (if RESEND_API_KEY not set, EMAIL_PASS is used)
# EMAIL_PASS=your_resend_api_key_here

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

CLIENT_URL=http://localhost:5173

# Admin seed credentials (REQUIRED for seed.js — script will refuse without these)
ADMIN_EMAIL=admin@gpsfdk.com
ADMIN_PASSWORD=your_strong_admin_password

# Shiprocket
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret
VERIFY_TOKEN=qwertyuiop_asdfghjkl_zxcvbnm
# Only set to "true" during initial Shiprocket webhook setup to allow their
# "Test Webhook" button (which sends no x-api-key). Remove afterwards.
# ALLOW_WEBHOOK_UNAUTH=true

# Firebase Web SDK key — used server-side in authController.verifyFirebaseToken
# to call Google Identity Toolkit. Get from Firebase Console → Project Settings
# → Your apps → Web app config → apiKey. ROTATE if it was ever in git history.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# ─── WhatsApp Business Cloud API (Meta) ─────────────────────────────────────
# REQUIRED for OTP delivery. Without these, user phone verification is disabled.
# Get these from developers.facebook.com → your WhatsApp Business app.
# IMPORTANT: Use a System User token (permanent), NOT the temporary test token
# which expires in ~24h and will silently break OTP delivery.
WHATSAPP_TOKEN=your_permanent_system_user_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
# Verify token for the Meta webhook handshake (GET /webhook/whatsapp).
# Paste the same string into Meta → WhatsApp → Configuration → Verify token.
WHATSAPP_VERIFY_TOKEN=gpsfdkverify
# Optional — override the template / Graph API version when Meta deprecates
# v22 or you rename the approved template. The default expects a Meta
# Authentication template (1 body param = OTP, 1 button param = OTP).
# Language must match Meta exactly: "English" = en, "English (US)" = en_US.
# WHATSAPP_API_VERSION=v22.0
# WHATSAPP_OTP_TEMPLATE=new_login_template
# WHATSAPP_OTP_TEMPLATE_LANG=en_US

# ─── Meta (Facebook) Conversions API ────────────────────────────────────────
# Server-side event tracking that complements the browser pixel. Browser
# pixel alone misses 30-40% of conversions (ad blockers, iOS ATT, network
# failures). CAPI sends events server-side after the DB write so Meta's
# reported purchases match real orders.
#
# Setup:
#   1. Go to Events Manager → your pixel → Settings tab
#   2. Scroll to "Conversions API" → click "Generate access token"
#   3. Paste the token below
#
# The pixel ID must match the one in client/index.html (currently 953916107234506).
META_PIXEL_ID=953916107234506
# REQUIRED — without this, 30-40% of purchase events are lost to ad blockers.
# Events Manager → your pixel → Settings → Conversions API → Generate access token
META_CAPI_ACCESS_TOKEN=your_capi_access_token_here
# Optional — set during testing so events land in Events Manager → Test Events
# instead of production stats. Remove or leave blank for production traffic.
# META_CAPI_TEST_EVENT_CODE=TEST12345
# Optional — Graph API version to call. Defaults to v22.0; bump if Meta deprecates.
# META_GRAPH_API_VERSION=v22.0
