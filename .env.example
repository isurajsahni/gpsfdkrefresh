# ==============================================================================
# The Borgo - Luxury MERN Ecommerce: Unified Local Environment Variables
# ==============================================================================
# Copy the appropriate variables into /server/.env and /client/.env respectively.
# Do NOT commit raw values to git.

# ──────────────────────────────────────────────────────────────────────────────
# BACKEND CONFIGURATION (/server/.env)
# ──────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/gpsfdk?retryWrites=true&w=majority

# JWT Authentication Secret (Use crypto.randomBytes(64).toString('hex') to generate)
JWT_SECRET=your_jwt_secret_here

# Cloudinary (Media upload storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Gateway (Resend API)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=your_verified_sender@domain.com
# Legacy fallback (optional)
# EMAIL_PASS=your_resend_api_key_here

# Razorpay (India Payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Stripe (Global Payments)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Firebase Web SDK key (Server-side token verification)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# Shiprocket (Logistics / Delivery Integration)
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret
VERIFY_TOKEN=qwertyuiop_asdfghjkl_zxcvbnm
# ALLOW_WEBHOOK_UNAUTH=true (Only use temporarily during webhook setup)

# WhatsApp Business Cloud API (REQUIRED for OTP delivery)
# Use a permanent System User token from developers.facebook.com
WHATSAPP_TOKEN=your_permanent_system_user_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=gpsfdkverify
# WHATSAPP_API_VERSION=v22.0
# WHATSAPP_OTP_TEMPLATE=new_login_template
# WHATSAPP_OTP_TEMPLATE_LANG=en_US

# Meta Conversions API (REQUIRED — server-side event tracking)
# Without this, 30-40% of purchase events are lost to ad blockers
META_PIXEL_ID=953916107234506
META_CAPI_ACCESS_TOKEN=your_capi_access_token_here
# META_CAPI_TEST_EVENT_CODE=TEST12345
# META_GRAPH_API_VERSION=v22.0

# Admin Seed Credentials (REQUIRED for seed.js — script refuses without these)
ADMIN_EMAIL=admin@gpsfdk.com
ADMIN_PASSWORD=your_strong_admin_password


# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND CONFIGURATION (/client/.env)
# ──────────────────────────────────────────────────────────────────────────────

# Base API endpoint for the Express server
VITE_API_URL=http://localhost:5000/api

# Stripe Public Key (Client-side Stripe Element SDK)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Firebase Web SDK config (Console -> Project Settings -> Your Apps)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
