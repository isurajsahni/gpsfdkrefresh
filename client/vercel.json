{
  "functions": {
    "api/render.js": {
      "includeFiles": "dist/app.html",
      "maxDuration": 10
    }
  },
  "redirects": [
    { "source": "/home(/?)", "destination": "https://www.gpsfdk.com/", "statusCode": 301 },
    { "source": "/staging-page(/?)", "destination": "https://www.gpsfdk.com/", "statusCode": 301 },
    { "source": "/wall-canvas(/?)", "destination": "https://www.gpsfdk.com/canvas", "statusCode": 301 },
    { "source": "/wall-canvas/all(/?)", "destination": "https://www.gpsfdk.com/canvas", "statusCode": 301 },
    { "source": "/canvas-v2-demo(/?)", "destination": "https://www.gpsfdk.com/canvas", "statusCode": 301 },
    { "source": "/about-us(/?)", "destination": "https://www.gpsfdk.com/about", "statusCode": 301 },
    { "source": "/contact-us(/?)", "destination": "https://www.gpsfdk.com/contact", "statusCode": 301 },
    { "source": "/shipping-delivery-policy(/?)", "destination": "https://www.gpsfdk.com/shipping-policy", "statusCode": 301 },
    { "source": "/shipment-tracking-2(/?)", "destination": "https://www.gpsfdk.com/track-order", "statusCode": 301 },
    { "source": "/canvas-vs-framed-prints-which-is-better-why-full-comparison-2025(/?)", "destination": "https://www.gpsfdk.com/blog/canvas-vs-framed-prints-best-investment", "statusCode": 301 },
    { "source": "/shop-by-videos(/?)", "destination": "https://www.gpsfdk.com/canvas", "statusCode": 301 },
    { "source": "/shop(/.*)?", "destination": "https://www.gpsfdk.com/store", "statusCode": 301 },
    { "source": "/feed(/?)", "destination": "https://www.gpsfdk.com/rss.xml", "statusCode": 301 },
    { "source": "/wp/blog/:slug([^/]+)(/?)", "destination": "https://www.gpsfdk.com/blog/:slug", "statusCode": 301 },
    { "source": "/tag/(.*)", "destination": "https://www.gpsfdk.com/blog", "statusCode": 301 },
    { "source": "/author/(.*)", "destination": "https://www.gpsfdk.com/about", "statusCode": 301 },
    { "source": "/founder(/?)", "destination": "https://www.gpsfdk.com/ceo", "statusCode": 301 },
    { "source": "/connect(/?)", "destination": "https://www.gpsfdk.com/contact", "statusCode": 301 },
    { "source": "/services(/?)", "destination": "https://www.gpsfdk.com/consultancy", "statusCode": 301 },
    { "source": "/learn(/?)", "destination": "https://www.gpsfdk.com/blog", "statusCode": 301 },
    { "source": "/product-category/wall-canvas/ink-interval(/.*)?", "destination": "https://www.gpsfdk.com/wall-canvas/ink--interval", "statusCode": 301 },
    { "source": "/product-category/wall-canvas/:collection(the-sassy-classic|tethered-horizons|the-botanical-muse|the-celestial-frontier|the-ethereal-gaze|the-gaze-of-power|the-modern-legend|the-gilded-bloom|the-velocity-suite|millionaire-art|nostalgia-noir|the-after-hour-suite|the-wild-eccentrics)(/.*)?", "destination": "https://www.gpsfdk.com/wall-canvas/:collection", "statusCode": 301 },
    { "source": "/product-category/:collection(millionaire-art|the-velocity-suite)(/.*)?", "destination": "https://www.gpsfdk.com/wall-canvas/:collection", "statusCode": 301 },
    { "source": "/product-category/flowers(/.*)?", "destination": "https://www.gpsfdk.com/wall-canvas/the-botanical-muse", "statusCode": 301 },
    { "source": "/product-category/galaxy-canvas(/.*)?", "destination": "https://www.gpsfdk.com/wall-canvas/the-celestial-frontier", "statusCode": 301 },
    { "source": "/product-category/:category(house-name-plates|value-packed-vinyl-plates)(/.*)?", "destination": "https://www.gpsfdk.com/house-nameplates", "statusCode": 301 },
    { "source": "/product-category(/.*)?", "destination": "https://www.gpsfdk.com/canvas", "statusCode": 301 },
    { "source": "/product/alpha-forst(/?)", "destination": "https://www.gpsfdk.com/product/alpha-frost", "statusCode": 301 },
    { "source": "/product/bradied-bloom(/?)", "destination": "https://www.gpsfdk.com/product/braided-bloom", "statusCode": 301 },
    { "source": "/product/bubblegum-glow(/?)", "destination": "https://www.gpsfdk.com/product/bubblegum-glow-1", "statusCode": 301 },
    { "source": "/product/the-ruby-magnate(/?)", "destination": "https://www.gpsfdk.com/product/the-ruby-magnet", "statusCode": 301 },
    { "source": "/product/:slug(lord-ganesha|silver-ganesha)(/?)", "destination": "https://www.gpsfdk.com/product/ganesha", "statusCode": 301 },
    { "source": "/product/:slug(modern-house|modern-house-2|modern-house-3|modern-house-4|modern-house-4-2)(/?)", "destination": "https://www.gpsfdk.com/product/modern-house-1", "statusCode": 301 },
    { "source": "/product/:slug(house-of-gold|house-of-gold-2|silver-circle|silver-circle-2|sunehra-naam|sunehra-nam|trishula|trishula-2)(/?)", "destination": "https://www.gpsfdk.com/house-nameplates", "statusCode": 301 },
    { "source": "/product/:code(ma-\\d+(?:-\\d+)?)(/?)", "destination": "https://www.gpsfdk.com/wall-canvas/millionaire-art", "statusCode": 301 },
    { "source": "/product/:code((?:aa|baw|c|cas|cow|flo|g|o|pt|sc|sp)-\\d+(?:-\\d+)?)(/?)", "destination": "https://www.gpsfdk.com/canvas", "statusCode": 301 },
    { "source": "/(.+)/", "destination": "https://www.gpsfdk.com/$1", "statusCode": 301 },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "gpsfdk.com" }], "destination": "https://www.gpsfdk.com/$1", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://gpsfdkrefresh.onrender.com/sitemap.xml" },
    {
      "source": "/:page(contact|track-order)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Pinterestbot|Pinterest|SkypeUriPreview|Viber|viber).*"
        }
      ],
      "destination": "https://gpsfdkrefresh.onrender.com/api/share/page/:page"
    },
    { "source": "/store", "destination": "/index.html" },
    { "source": "/:page(about|ceo|vision|consultancy|faq|shipping-policy|returns-refunds|privacy-policy|terms-conditions|support|customize-canvas|premium-wall-canvas-india|canvas|blog)", "destination": "/:page/index.html" },
    { "source": "/:page(search|cart|login|register|forgot-password|whatsapp-login|contact|school-of-learning|love|partner|checkout|thank-you|dashboard|track-order|consultancy-v2-demo)", "destination": "/app.html" },
    { "source": "/house-nameplates", "destination": "/api/render?path=/house-nameplates" },
    { "source": "/product/:slug", "destination": "/api/render?path=/product/:slug" },
    { "source": "/blog/:slug", "destination": "/blog/:slug/index.html" },
    { "source": "/location/:city", "destination": "/location/:city/index.html" },
    { "source": "/wall-canvas/:collection(ink--interval|the-sassy-classic|tethered-horizons|the-botanical-muse|the-celestial-frontier|the-ethereal-gaze|the-gaze-of-power|the-modern-legend|the-gilded-bloom|the-velocity-suite|millionaire-art|nostalgia-noir|the-after-hour-suite|the-wild-eccentrics)", "destination": "/api/render?path=/wall-canvas/:collection" },
    { "source": "/admin/:path*", "destination": "/app.html" },
    { "source": "/marketing/:path*", "destination": "/app.html" },
    { "source": "/invoice-preview/:path*", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/(register|login|search|cart|checkout|thank-you|dashboard|forgot-password|whatsapp-login|track-order|consultancy-v2-demo)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/(admin|marketing|invoice-preview)(/.*)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/assets/((?!store-entry-).*\\.mp4)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(store-entry-.*\\.mp4)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*\\.(?:js|css|woff2?|png|jpe?g|webp|avif|gif|svg))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), accelerometer=(self), gyroscope=(self), payment=(self \"https://checkout.razorpay.com\" \"https://api.razorpay.com\" \"https://js.stripe.com\")" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Reporting-Endpoints", "value": "csp-endpoint=\"https://gpsfdkrefresh.onrender.com/api/csp-report\"" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-GrVK2ylU1ms4yO7FrCcu2iXqECjbZUqYvgBXn48pf64=' 'sha256-egQy6ZRhxe6401vhUzCxDWhiynpY4GLtm9aZEV8gmLo=' https://ajax.googleapis.com https://www.gstatic.com https://*.razorpay.com https://checkout.razorpay.com https://cdn.razorpay.com https://*.stripe.com https://js.stripe.com https://connect.facebook.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://images.unsplash.com https://*.razorpay.com https://www.facebook.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com; connect-src 'self' https://ar-sage-eight.vercel.app https://www.gstatic.com https://gpsfdkrefresh.onrender.com https://*.onrender.com https://api.cloudinary.com https://*.razorpay.com https://*.stripe.com https://api.stripe.com https://api.postalpincode.in https://www.facebook.com https://*.facebook.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://va.vercel-scripts.com; frame-src 'self' https://*.razorpay.com https://*.stripe.com https://checkout.razorpay.com https://api.razorpay.com https://js.stripe.com https://*.facebook.com https://www.facebook.com; child-src 'self' https://*.razorpay.com https://*.stripe.com https://checkout.razorpay.com https://api.razorpay.com; media-src 'self' blob:; worker-src 'self' blob:; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; report-uri https://gpsfdkrefresh.onrender.com/api/csp-report; report-to csp-endpoint;"
        }

      ]
    }
  ]
}
